# 生产部署环境变量样例
# 用法：cp .env.production.example .env.production，填入真实值（.env.production 不入库）
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# 对外访问来源（精确 scheme://host[:port]，多个用逗号）；前端浏览器看到的地址
ALLOWED_ORIGINS=https://interview.example.com
# 前端映射到宿主机的端口（80 需要 root/setcap，本机测试可用 8080）
HTTP_PORT=80

# PostgreSQL（务必改密码）
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=ai_interview

# MinIO（务必改密钥；生产建议另配外部对象存储）
STORAGE_ACCESS_KEY=change-me-access-key
STORAGE_SECRET_KEY=change-me-strong-secret
STORAGE_BUCKET=ai-interview

# JWT：至少 32 位随机串，例如 openssl rand -hex 32；更换后所有已登录 token 失效
JWT_SECRET=please-run-openssl-rand-hex-32
JWT_EXPIRE_TIME=2h
REFRESH_TOKEN_TTL=720h

# 本实例是否消费异步任务（API/worker 分离部署时：API 节点 false，worker 节点 true，至少一个 true）
TASK_ENABLED=true
TASK_WORKERS=2

# ===== AI Provider（留空/保持 mock 可离线联调，上线必须替换）=====
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

ASR_PROVIDER=mock
ASR_API_KEY=

TTS_PROVIDER=mock
TTS_API_KEY=

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
