# App
APP_NAME=ai-interview-platform
APP_ENV=dev

# ===== Server =====
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
# WebSocket 跨域 Origin 白名单（逗号分隔，精确匹配 scheme://host[:port]）。
# 留空=放行全部来源（仅限本地开发）；APP_ENV=prod 时必须配置。
ALLOWED_ORIGINS=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_interview
DB_SSLMODE=disable
DB_MAX_CONNS=25

# Redis
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (MinIO)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-interview
STORAGE_USE_SSL=false

# JWT（access 短期、refresh 长期；数据库仅存 refresh 的 SHA-256）
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_TIME=2h
REFRESH_TOKEN_TTL=720h
JWT_ISSUER=ai-interview-platform

# 安全：请求体上限与单机令牌桶限流（多实例部署需改 Redis 版）
MAX_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=12582912
RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_MINUTE=10
API_RATE_PER_MINUTE=120

# LLM
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ASR (语音转写)
ASR_PROVIDER=mock
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh

# TTS (面试官语音合成)
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3

# Embedding (RAG)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Log
LOG_LEVEL=info
LOG_FORMAT=json
